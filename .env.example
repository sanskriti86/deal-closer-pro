# =====================================================
# FRONTEND (Vite) — copy this file to .env and fill in
# =====================================================

# Supabase project (find in Supabase dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...


# =====================================================
# EDGE FUNCTION SECRETS — set via Supabase CLI:
#
#   supabase secrets set RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
#   supabase secrets set RAZORPAY_KEY_SECRET=xxxxxxxx
#   supabase secrets set RAZORPAY_WEBHOOK_SECRET=xxxxxxxx  # recommended; otherwise key secret is used
#   supabase secrets set RESEND_API_KEY=re_xxxxxxxx
#   supabase secrets set SITE_URL=https://ishwarisocials.co
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected.
# Emails are sent from managingteam@ishwarisocials.co and owner notifications
# are delivered to managingteam@ishwarisocials.co.
#
# Razorpay webhook URL:
#   https://YOUR_PROJECT_REF.supabase.co/functions/v1/razorpay-webhook
# Subscribe to payment.captured, payment.failed, and refund.processed.
# =====================================================
